# Flutter / Dart
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/build/
app/pubspec.lock
# Die Plattformordner bleiben generiert - mit einer Ausnahme: ohne die
# INTERNET-Berechtigung im Haupt-Manifest hat der Release-Build keinerlei
# Netzzugang, und `flutter create` legt sie nur in die Debug- und
# Profile-Manifeste. Die Datei ueberlebt ein erneutes `flutter create`.
app/android/*
!app/android/app/
app/android/app/*
!app/android/app/src/
# Release-Signierung: wird von der CI in das erzeugte build.gradle(.kts)
# eingebunden, siehe app/android/app/signing.gradle.
!app/android/app/signing.gradle
app/android/app/src/*
!app/android/app/src/main/
app/android/app/src/main/*
!app/android/app/src/main/AndroidManifest.xml
app/ios/
app/windows/
app/linux/
app/macos/
app/web/
# Boilerplate, das `flutter create` immer wieder anlegt - das Root-README
# deckt alles ab.
app/README.md
app/test/widget_test.dart
app/.idea/
*.iml

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Lokales
.env
*.db
.DS_Store

# Lokale Suchquelle
search/.env
