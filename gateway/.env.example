# Kopie als .env anlegen und Werte setzen (nicht ins Repo committen).
GATEWAY_TOKEN=hier-ein-langes-zufaelliges-geheimnis

# Schaltet die OpenAI-kompatible Oberflaeche unter /openai/v1 ein (siehe
# AGENTS.md). Leer lassen heisst: es gibt sie nicht. Muss sich von
# GATEWAY_TOKEN unterscheiden, sonst laesst sich der Agentenzugang nicht
# getrennt zurueckziehen.
GATEWAY_AGENT_TOKEN=

OLLAMA_URL=http://127.0.0.1:11434
LMSTUDIO_URL=http://127.0.0.1:1234
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8765
TELEMETRY_INTERVAL=1.0
GATEWAY_TIMEOUT=600

# Obergrenze fuer den Anfragekoerper in Bytes.
GATEWAY_MAX_REQUEST_BYTES=33554432

# --- Recherche -------------------------------------------------------------
# Die einzige Stelle, an der das Gateway etwas ausfuehrt: Websuche und
# Seitenabruf. Standardmaessig aus. Ausgefuehrt wird nur, was in der App
# einzeln freigegeben wurde.
GATEWAY_RESEARCH=

# Suchquelle: none | searxng | brave. Ohne Quelle bietet das Gateway nur den
# Seitenabruf an - eine Suche anzubieten, die dann scheitert, kostet einen Zug
# und eine Freigabe fuer nichts.
GATEWAY_SEARCH_PROVIDER=none
GATEWAY_SEARXNG_URL=
GATEWAY_BRAVE_KEY=

GATEWAY_RESEARCH_TIMEOUT=20
GATEWAY_RESEARCH_MAX_RESULTS=6
GATEWAY_RESEARCH_MAX_CHARS=12000
